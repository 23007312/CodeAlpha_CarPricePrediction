"        ""import pandas as pd\n"","
"        ""import numpy as np\n"","
"        ""import matplotlib.pyplot as plt\n"","
"        ""import seaborn as sns\n"","
"        ""from sklearn.model_selection import train_test_split\n"","
"        ""from sklearn.linear_model import LinearRegression\n"","
"        ""from sklearn.ensemble import RandomForestRegressor\n"","
"        ""from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n"","
"        ""import warnings\n"","
"        ""warnings.filterwarnings('ignore')\n"","
"        ""\n"","
"        ""# Load the dataset\n"","
"        ""df = pd.read_csv('car data.csv')\n"","
"        ""\n"","
"        ""# Display basic info\n"","
"        ""print(\""Dataset Shape:\"", df.shape)\n"","
"        ""print(\""\\nFirst 5 rows:\"")\n"","
"        ""print(df.head())\n"","
"        ""print(\""\\nDataset Info:\"")\n"","
        "print(df.info())"
      ]
"    },"
    {
"      ""cell_type"": ""code"","
      "source": [
"        ""# 1. Check for missing values\n"","
"        ""print(\""Missing values:\\n\"", df.isnull().sum())\n"","
"        ""\n"","
"        ""# 2. Check unique values in categorical columns\n"","
"        ""print(\""\\nFuel Types:\"", df['Fuel_Type'].unique())\n"","
"        ""print(\""Seller Types:\"", df['Selling_type'].unique())\n"","
"        ""print(\""Transmission Types:\"", df['Transmission'].unique())\n"","
"        ""\n"","
"        ""# 3. FILTER OUT MOTORCYCLES (Keep only cars)\n"","
"        ""# Cars generally have a Present_Price > 3 Lakhs, bikes are < 3 Lakhs\n"","
"        ""# We also know bikes have specific names like 'Royal Enfield', 'KTM', 'Bajaj'\n"","
"        ""bike_keywords = ['Royal Enfield', 'KTM', 'Bajaj', 'Yamaha', 'Honda CB', 'Hero', 'TVS',\n"","
"        ""                 'Hyosung', 'Mahindra Mojo', 'UM Renegade', 'Suzuki Access', 'Activa']\n"","
"        ""\n"","
"        ""# Create a mask to filter out bikes\n"","
"        ""df = df[~df['Car_Name'].str.contains('|'.join(bike_keywords), case=False, na=False)]\n"","
"        ""\n"","
"        ""# Reset index after filtering\n"","
"        ""df = df.reset_index(drop=True)\n"","
"        ""print(f\""\\nDataset Shape after removing bikes: {df.shape}\"")\n"","
"        ""\n"","
"        ""# 4. Feature Engineering: Create 'Car_Age' instead of 'Year'\n"","
"        ""current_year = 2024 # Assuming current year\n"","
"        ""df['Car_Age'] = current_year - df['Year']\n"","
"        ""\n"","
"        ""# Drop the original 'Year' and 'Car_Name' columns\n"","
"        ""df.drop(['Year', 'Car_Name'], axis=1, inplace=True)\n"","
"        ""\n"","
"        ""# 5. Encode Categorical Variables (Convert text to numbers)\n"","
"        ""# We use One-Hot Encoding for Fuel_Type, Selling_type, and Transmission\n"","
"        ""df = pd.get_dummies(df, columns=['Fuel_Type', 'Selling_type', 'Transmission'], drop_first=True)\n"","
"        ""\n"","
"        ""print(\""\\nData after encoding:\"")\n"","
        "print(df.head())"
